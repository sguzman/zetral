import Mathlib.Algebra.Order.Ring.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Order.BigOperators.Group.Finset

/-! A finite-dimensional formalization of the clipping step used in PC65-W02.

This file proves an abstract quadratic-form statement. It does not certify any
interval generated by the campaign code or any tail/complement estimate. -/

namespace Zetral.PC65Clipping

open scoped BigOperators

variable {ι κ : Type*}

/-- A one-sided lower enclosure suffices for the clipped value to lie in the
reported interval, even when the exact value exceeds the upper endpoint. -/
theorem clipped_mem_interval {α : Type*} [LinearOrder α]
    (lower exact upper : α)
    (hlower_exact : lower ≤ exact) (hlower_upper : lower ≤ upper) :
    lower ≤ min exact upper ∧ min exact upper ≤ upper := by
  exact ⟨le_min hlower_exact hlower_upper, min_le_right exact upper⟩

/-- The diagonal quadratic form after an arbitrary fixed change of
coordinates. The first index is the diagonal coordinate; the second indexes
the transformed vector. -/
def diagonalCongruence {α : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] [Semiring α]
    (diagonal : ι → α) (transform : ι → κ → α) (x : κ → α) : α :=
  ∑ i : ι, diagonal i * (∑ j : κ, transform i j * x j) ^ 2

/-- The difference between the exact and clipped congruence forms is exactly
the quadratic form of the nonnegative diagonal correction. -/
theorem congruence_difference_eq {α : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] [CommRing α] [Min α]
    (diagonal upper : ι → α) (transform : ι → κ → α) (x : κ → α) :
    diagonalCongruence diagonal transform x -
        diagonalCongruence (fun i => min (diagonal i) (upper i)) transform x =
      ∑ i : ι, (diagonal i - min (diagonal i) (upper i)) *
        (∑ j : κ, transform i j * x j) ^ 2 := by
  simp only [diagonalCongruence]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  rw [sub_mul]

/-- For an ordered ring, the congruence correction is positive semidefinite:
its quadratic form is nonnegative for every vector and every fixed transform. -/
theorem clipped_congruence_psd {α : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] [CommRing α] [LinearOrder α] [IsStrictOrderedRing α]
    (diagonal upper : ι → α) (transform : ι → κ → α) (x : κ → α) :
    0 ≤ diagonalCongruence diagonal transform x -
        diagonalCongruence (fun i => min (diagonal i) (upper i)) transform x := by
  rw [congruence_difference_eq]
  apply Finset.sum_nonneg
  intro i hi
  apply mul_nonneg
  · exact sub_nonneg.mpr (min_le_left (diagonal i) (upper i))
  · exact sq_nonneg _

end Zetral.PC65Clipping

#print axioms Zetral.PC65Clipping.clipped_mem_interval
#print axioms Zetral.PC65Clipping.congruence_difference_eq
#print axioms Zetral.PC65Clipping.clipped_congruence_psd
